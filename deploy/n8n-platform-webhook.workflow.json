    {
      "id": "51679494-2d2e-417f-86a8-2a6baf1d1cb5",
      "name": "Prepare opted-in recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const eligibility = $input.first().json;\nconst event = $('Event state').first().json;\nconst labels = { BOOKING_CREATED: 'Your booking is confirmed', BOOKING_REQUESTED: 'Your booking request was received', BOOKING_CANCELLED: 'Your booking was cancelled', BOOKING_RESCHEDULED: 'Your booking was rescheduled' };\nconst startTime = Date.parse(eligibility.startTime);\nif (!Number.isFinite(startTime)) throw new Error('Invalid booking time');\nconst when = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Istanbul' }).format(new Date(startTime));\nconst message = `rOndevu: ${labels[event.triggerEvent]}. ${when} (Istanbul time). Reply DUR to stop these messages.`;\nconst recipients = Array.isArray(eligibility.recipients) ? eligibility.recipients : [];\nconst items = recipients.flatMap((recipient) => {\n  if (!recipient || typeof recipient.phoneNumber !== 'string' || !/^\\+?[1-9]\\d{7,14}$/.test(recipient.phoneNumber)) return [];\n  const phoneNumber = recipient.phoneNumber.replace(/^\\+/, '');\n  return [{ json: { eventId: event.eventId, role: recipient.role === 'host' ? 'host' : 'guest', phoneNumber, message } }];\n});\nif (items.length === 0) return [{ json: { eventId: event.eventId, skip: true } }];\nreturn items;"
      }
    },
