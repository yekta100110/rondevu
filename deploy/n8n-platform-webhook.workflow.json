      "id": "bad86537-c249-41fd-bf2b-4c594b0a4433",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "binaryData": true,
        "binaryPropertyName": "data",
        "encoding": "hex",
        "dataPropertyName": "computedHmac"
