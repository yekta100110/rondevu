    {
      "id": "9669ac02-e46e-4071-b356-682a24cf76e1",
      "name": "Claim recipient",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2640,
        480
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH input AS (SELECT $1::text AS event_id, $2::text AS role, $3::text AS phone_number, $4::text AS message, encode(digest($2 || ':' || $3, 'sha256'), 'hex') AS recipient_hash), inserted AS (INSERT INTO recipient_delivery (event_id, recipient_hash, status) SELECT event_id, recipient_hash, 'SENDING' FROM input ON CONFLICT (event_id, recipient_hash) DO UPDATE SET status = 'SENDING', updated_at = now() WHERE recipient_delivery.status IN ('PENDING', 'FAILED') RETURNING event_id, recipient_hash) SELECT input.*, input.recipient_hash, EXISTS (SELECT 1 FROM inserted) AS claimed, COALESCE((SELECT status FROM recipient_delivery WHERE event_id = input.event_id AND recipient_hash = input.recipient_hash), '') AS existing_status FROM input",
        "options": {
          "queryReplacement": "={{ [$json.eventId, $json.role, $json.phoneNumber, $json.message] }}"
        }
      },
