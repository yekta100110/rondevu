    {
      "id": "50adf0ef-d14c-42cf-a1f1-47dcf3658cf5",
      "name": "Validate event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst headers = input.headers ?? {};\nconst signature = headers['x-cal-signature-256'];\nconst computed = input.computedHmac;\nif (typeof signature !== 'string' || !/^[0-9a-f]{64}$/i.test(signature) || typeof computed !== 'string' || !/^[0-9a-f]{64}$/i.test(computed)) throw new Error('Invalid webhook signature');\nlet mismatch = 0;\nfor (let i = 0; i < 64; i++) mismatch |= signature.charCodeAt(i) ^ computed.charCodeAt(i);\nif (mismatch !== 0) throw new Error('Invalid webhook signature');\nconst eventId = headers['x-rondevu-event-id'];\nconst timestamp = headers['x-rondevu-timestamp'];\nconst body = typeof input.body === 'string' ? JSON.parse(input.body) : input.body;\nif (!body || typeof body !== 'object' || !/^[0-9a-f]{64}$/i.test(eventId ?? '')) throw new Error('Invalid webhook event');\nif (typeof timestamp !== 'string' || body.createdAt !== timestamp) throw new Error('Invalid webhook timestamp');\nconst time = Date.parse(timestamp);\nif (!Number.isFinite(time) || Math.abs(Date.now() - time) > 24 * 60 * 60 * 1000) throw new Error('Expired webhook event');\nconst supported = ['BOOKING_CREATED','BOOKING_PAYMENT_INITIATED','BOOKING_PAID','BOOKING_RESCHEDULED','BOOKING_REQUESTED','BOOKING_CANCELLED','BOOKING_REJECTED','BOOKING_NO_SHOW_UPDATED','FORM_SUBMITTED','MEETING_ENDED','MEETING_STARTED','RECORDING_READY','RECORDING_TRANSCRIPTION_GENERATED','OOO_CREATED','AFTER_HOSTS_CAL_VIDEO_NO_SHOW','AFTER_GUESTS_CAL_VIDEO_NO_SHOW','FORM_SUBMITTED_NO_EVENT','DELEGATION_CREDENTIAL_ERROR','WRONG_ASSIGNMENT_REPORT'];\nconst triggerEvent = body.triggerEvent;\nif (!supported.includes(triggerEvent)) throw new Error('Invalid webhook event type');\nconst bookingUid = typeof body.payload?.uid === 'string' ? body.payload.uid : null;\nconst notifyEvents = ['BOOKING_CREATED','BOOKING_REQUESTED','BOOKING_CANCELLED','BOOKING_RESCHEDULED'];\nreturn [{ json: { eventId: eventId.toLowerCase(), triggerEvent, createdAt: timestamp, bookingUid, notify: notifyEvents.includes(triggerEvent) && Boolean(bookingUid) } }];"
      }
    },
    {
      "id": "c0963cca-7355-4db2-af1a-6598fb720275",
      "name": "Record event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO event_delivery (event_id, trigger_event, status, attempts) VALUES ($1, $2, 'PROCESSING', 1) ON CONFLICT (event_id) DO UPDATE SET attempts = event_delivery.attempts + 1, status = CASE WHEN event_delivery.status = 'COMPLETED' THEN 'COMPLETED' ELSE 'PROCESSING' END, updated_at = now() RETURNING event_id, status, attempts",
        "options": {
          "queryReplacement": "={{ [$json.eventId, $json.triggerEvent] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "rOndevu event dedup"
        }
      }
