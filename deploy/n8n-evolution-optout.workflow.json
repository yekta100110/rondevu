      "id": "83b1fa35-ebaa-4cae-8936-bad5a1b3aaef",
      "name": "Parse STOP or DUR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const root = $input.first().json.body ?? {};\nconst event = String(root.event ?? '').toLowerCase();\nconst data = root.data ?? {};\nconst key = data.key ?? data.message?.key ?? {};\nconst message = data.message ?? {};\nconst text = message.conversation ?? message.extendedTextMessage?.text ?? message.ephemeralMessage?.message?.conversation ?? message.viewOnceMessage?.message?.conversation ?? '';\nconst command = String(text).trim().toLocaleUpperCase('tr-TR');\nconst remoteJid = String(key.remoteJid ?? '');\nif (event !== 'messages.upsert' || key.fromMe === true || !remoteJid.endsWith('@s.whatsapp.net') || !['STOP', 'DUR', 'İPTAL'].includes(command)) return [{ json: { shouldOptOut: false } }];\nconst digits = remoteJid.slice(0, -'@s.whatsapp.net'.length);\nif (!/^[1-9]\\d{7,14}$/.test(digits)) return [{ json: { shouldOptOut: false } }];\nreturn [{ json: { shouldOptOut: true, phoneNumber: `+${digits}` } }];"
      }
    },
